/* RESET & BASE */
* {
      margin: 0;
        padding: 0;
          box-sizing: border-box;
}

body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
          scroll-behavior: smooth;
}

/* NAVBAR */
nav {
      display: flex;
        justify-content: space-between;
          align-items: center;
            padding: 15px 30px;
              background: #1a1a2e;
                position: fixed;
                  width: 100%;
                    top: 0;
                      z-index: 1000;
}

.logo {
      color: #e94560;
        font-size: 1.5rem;
          font-weight: bold;
}

.nav-links {
      display: flex;
        list-style: none;
          gap: 20px;
}

.nav-links a {
      color: white;
        text-decoration: none;
          font-size: 0.9rem;
            transition: color 0.3s;
}

.nav-links a:hover {
      color: #e94560;
}

/* HERO */
.hero {
      min-height: 100vh;
        display: flex;
          align-items: center;
            justify-content: center;
              text-align: center;
                padding: 80px 20px 40px;
                  background: linear-gradient(135deg, #0f3460, #16213e, #1a1a2e);
                    color: white;
}

.hero h1 {
      font-size: 2.2rem;
        margin-bottom: 15px;
          line-height: 1.3;
}

.hero p {
      font-size: 1.1rem;
        margin-bottom: 30px;
          opacity: 0.8;
}

/* BUTTON */
.btn {
      background: #e94560;
        color: white;
          border: none;
            padding: 12px 30px;
              font-size: 1rem;
                border-radius: 50px;
                  cursor: pointer;
                    transition: all 0.3s;
}

.btn:hover {
      background: #c73650;
        transform: translateY(-2px);
          box-shadow: 0 5px 15px rgba(233, 69, 96, 0.4);
}

.hasil {
      margin-top: 20px;
        padding: 15px;
          background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
              display: none;
                animation: fadeIn 0.5s;
}

.hasil.show {
      display: block;
}

@keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
}

/* TENTANG */
.tentang {
      padding: 80px 20px;
        text-align: center;
          background: #f8f9fa;
}

.tentang h2 {
      font-size: 2rem;
        margin-bottom: 40px;
          color: #1a1a2e;
}

.card-container {
      display: flex;
        flex-wrap: wrap;
          justify-content: center;
            gap: 20px;
              max-width: 900px;
                margin: 0 auto;
}

.card {
      background: white;
        padding: 30px 20px;
          border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
              flex: 1;
                min-width: 250px;
                  max-width: 280px;
                    transition: transform 0.3s;
}

.card:hover {
      transform: translateY(-5px);
}

.card-icon {
      font-size: 2.5rem;
        margin-bottom: 15px;
}

.card h3 {
      margin-bottom: 10px;
        color: #1a1a2e;
}

.card p {
      color: #666;
        font-size: 0.95rem;
}

/* KONTAK */
.kontak {
      padding: 80px 20px;
        text-align: center;
          background: #1a1a2e;
            color: white;
}

.kontak h2 {
      font-size: 2rem;
        margin-bottom: 40px;
}

#form-kontak {
      max-width: 500px;
        margin: 0 auto;
          display: flex;
            flex-direction: column;
              gap: 15px;
}

#form-kontak input,
#form-kontak textarea {
      padding: 12px 15px;
        border: none;
          border-radius: 10px;
            font-size: 1rem;
              background: rgba(255, 255, 255, 0.1);
                color: white;
                  border: 1px solid rgba(255, 255, 255, 0.2);
}

#form-kontak input::placeholder,
#form-kontak textarea::placeholder {
      color: rgba(255, 255, 255, 0.5);
}

#form-kontak input:focus,
#form-kontak textarea:focus {
      outline: none;
        border-color: #e94560;
}

/* FOOTER */
footer {
      padding: 20px;
        text-align: center;
          background: #0f3460;
            color: rgba(255, 255, 255, 0.6);
              font-size: 0.9rem;
}

/* RESPONSIVE */
@media (max-width: 768px) {
      .hero h1 {
            font-size: 1.6rem;
      }

        .nav-links {
                gap: 10px;
        }

          .nav-links a {
                font-size: 0.8rem;
          }

            .card {
                    min-width: 100%;
            }
}
            }
          }
        }
      }
}
}
