<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Website Pertamaku</title>
        <link rel="stylesheet" href="style.css">
        </head>
        <body>

          <!-- HEADER -->
            <header>
                <nav>
                      <div class="logo">🌐 WebKu</div>
                            <ul class="nav-links">
                                    <li><a href="#beranda">Beranda</a></li>
                                            <li><a href="#tentang">Tentang</a></li>
                                                    <li><a href="#kontak">Kontak</a></li>
                                                          </ul>
                                                              </nav>
                                                                </header>

                                                                  <!-- HERO SECTION -->
                                                                    <section id="beranda" class="hero">
                                                                        <div class="hero-content">
                                                                              <h1>Selamat Datang di Website Pertamaku! 🎉</h1>
                                                                                    <p>Dibuat dengan Node.js, Express, dan di-deploy ke Vercel</p>
                                                                                          <button id="btn-salam" class="btn">Klik untuk Salam dari Server</button>
                                                                                                <div id="hasil-salam" class="hasil"></div>
                                                                                                    </div>
                                                                                                      </section>

                                                                                                        <!-- TENTANG SECTION -->
                                                                                                          <section id="tentang" class="tentang">
                                                                                                              <h2>Tentang Website Ini</h2>
                                                                                                                  <div class="card-container">
                                                                                                                        <div class="card">
                                                                                                                                <div class="card-icon">📱</div>
                                                                                                                                        <h3>Responsive</h3>
                                                                                                                                                <p>Tampil sempurna di HP maupun laptop</p>
                                                                                                                                                      </div>
                                                                                                                                                            <div class="card">
                                                                                                                                                                    <div class="card-icon">⚡</div>
                                                                                                                                                                            <h3>Cepat</h3>
                                                                                                                                                                                    <p>Dibangun dengan Node.js & Express</p>
                                                                                                                                                                                          </div>
                                                                                                                                                                                                <div class="card">
                                                                                                                                                                                                        <div class="card-icon">🚀</div>
                                                                                                                                                                                                                <h3>Online</h3>
                                                                                                                                                                                                                        <p>Di-deploy gratis menggunakan Vercel</p>
                                                                                                                                                                                                                              </div>
                                                                                                                                                                                                                                  </div>
                                                                                                                                                                                                                                    </section>

                                                                                                                                                                                                                                      <!-- KONTAK SECTION -->
                                                                                                                                                                                                                                        <section id="kontak" class="kontak">
                                                                                                                                                                                                                                            <h2>Hubungi Saya</h2>
                                                                                                                                                                                                                                                <form id="form-kontak">
                                                                                                                                                                                                                                                      <input type="text" placeholder="Nama kamu" required>
                                                                                                                                                                                                                                                            <input type="email" placeholder="Email kamu" required>
                                                                                                                                                                                                                                                                  <textarea placeholder="Pesan kamu" rows="4" required></textarea>
                                                                                                                                                                                                                                                                        <button type="submit" class="btn">Kirim Pesan</button>
                                                                                                                                                                                                                                                                            </form>
                                                                                                                                                                                                                                                                                <div id="form-result" class="hasil"></div>
                                                                                                                                                                                                                                                                                  </section>

                                                                                                                                                                                                                                                                                    <!-- FOOTER -->
                                                                                                                                                                                                                                                                                      <footer>
                                                                                                                                                                                                                                                                                          <p>© 2025 Website Pertamaku | Dibuat dengan ❤️ dari HP Android</p>
                                                                                                                                                                                                                                                                                            </footer>

                                                                                                                                                                                                                                                                                              <script src="script.js"></script>
                                                                                                                                                                                                                                                                                              </body>
                                                                                                                                                                                                                                                                                              </html>